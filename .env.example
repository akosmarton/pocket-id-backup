# Pocket ID database — keep identical to your pocket-id service
# SQLite (default): the file must be mounted at /app/data
# DB_CONNECTION_STRING=data/pocket-id.db
# PostgreSQL: the job runs pg_dump against this URI
# DB_CONNECTION_STRING=postgres://user:password@host:5432/pocketid

# Backup target — BACKUP_S3_BUCKET and the credentials are required
# BACKUP_S3_BUCKET=my-pocket-id-backups
# UpCloud Object Storage: the instance endpoint, virtual-host style, no region
# BACKUP_S3_ENDPOINT=https://<instance-id>.upcloudobjects.com
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_REGION=                           # leave unset for UpCloud; unset = AWS default
# Retention: configure lifecycle/TTL rules on the dumps/ prefix — the app never deletes objects
